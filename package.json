{
  "name": "devstudio",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "DevStudio — all-in-one browser-based developer productivity suite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@date-fns/tz": "^1.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@tanstack/react-virtual": "^3.14.26",
    "cron-parser": "^5.10.2",
    "cronstrue": "^3.38.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "entities": "^8.1.0",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.12.0",
    "fast-xml-validator": "^1.4.2",
    "file-saver": "^2.0.5",
    "iconsax-reactjs": "^0.0.8",
    "jose": "^6.2.13",
    "jsonpath-plus": "^11.2.2",
    "jszip": "^3.10.2",
    "marked": "^18.1.2",
    "mime": "^4.1.1",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "ua-parser-js": "^1.0.41",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
